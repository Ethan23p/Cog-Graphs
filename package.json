{
  "name": "cog-graphs",
  "version": "0.3.1-dev",
  "description": "Spawn and manipulate persistent structured stores (Cognitive Graphs) on demand — a CLI whose user is an AI agent",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test testing/tests",
    "eval:smoke": "bun run testing/evals/eval_smoke.ts",
    "eval:skeleton": "bun run testing/evals/eval_walking_skeleton.ts",
    "eval:zero-priming": "bun run testing/evals/eval_zero_priming.ts",
    "eval:errors": "bun run testing/evals/eval_error_next_steps.ts",
    "verify:claims": "bun run testing/harness/verify-claims.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.214"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
